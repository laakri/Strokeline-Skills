// Purpose: Deterministic Rough.js outline and draw-on reveal.
// Features used: ROUGH on.
VERSION 1.0
CANVAS 1000 600
STYLE clean
STROKE 4

SCENE 1 "Rough outline"
  CREATE idea AS RECTANGLE
    POSITION 500 300
    WIDTH 360
    HEIGHT 180
    CORNERS 24
    FILL #E8F0FF
    COLOR #2563EB
    TEXT "Sketch the idea"
    SIZE 34
    ROUGH on
    DRAW 1s
  END
END SCENE
