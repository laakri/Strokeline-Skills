// Purpose: Cross-type geometric morph using Flubber.
// Features used: MORPH (circle to diamond).
VERSION 1.0
CANVAS 1000 600
STYLE clean
STROKE 4

SCENE 1 "Shape morph"
  CREATE before AS CIRCLE
    POSITION 300 300
    RADIUS 90
    COLOR #92400E
    FILL #FFF4D6
    TEXT "Before"
    SIZE 30
    DRAW 0.6s
  END
  CREATE after AS DIAMOND
    POSITION 700 300
    WIDTH 220
    HEIGHT 180
    COLOR #166534
    FILL #DCFCE7
    TEXT "After"
    SIZE 30
    DRAW 0.6s
  END
  ANIMATE before MORPH TO after
    DURATION 1s
    EASE easeInOut
END SCENE
