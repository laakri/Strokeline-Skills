// Purpose: Explain how a request becomes a cached response in five beats.
// Features used: five scenes, narration, transitions, sequential reveals.
// Validator status: checked.
// Remaining warnings: none.
VERSION 1.0
CANVAS 1920 1080
STYLE clean
FONT neat
BACKGROUND #F7F9FC

SCENE 1 "The request"
  SAY "A page request begins at the user's device."
    DURATION 3s
    TONE hook
  CREATE request AS RECTANGLE
    POSITION 960 500
    WIDTH 520
    HEIGHT 150
    CORNERS 24
    FILL #E8F1FA
    COLOR #243C46
    TEXT "Browser sends a request"
    SIZE 36
    DRAW 0.6s
  END
  TRANSITION fade DURATION 0.4s
END SCENE

SCENE 2 "The edge"
  SAY "The edge checks security before forwarding it."
    DURATION 3s
    TONE explain
  CREATE edge AS RECTANGLE
    POSITION 960 500
    WIDTH 520
    HEIGHT 150
    CORNERS 24
    FILL #E7F4EC
    COLOR #243C46
    TEXT "Edge filters and routes"
    SIZE 36
    DRAW 0.6s
  END
  TRANSITION slide DURATION 0.4s
END SCENE

SCENE 3 "The service"
  SAY "The service handles the request and reads what it needs."
    DURATION 3s
    TONE explain
  CREATE service AS RECTANGLE
    POSITION 960 500
    WIDTH 520
    HEIGHT 150
    CORNERS 24
    FILL #FFF3D9
    COLOR #243C46
    TEXT "Service reads the data"
    SIZE 36
    DRAW 0.6s
  END
  TRANSITION wipe DURATION 0.4s
END SCENE

SCENE 4 "The cache"
  SAY "A reusable result can be saved for the next request."
    DURATION 3s
    TONE explain
  CREATE cache AS RECTANGLE
    POSITION 960 500
    WIDTH 520
    HEIGHT 150
    CORNERS 24
    FILL #F2EAFE
    COLOR #243C46
    TEXT "Cache keeps a useful result"
    SIZE 36
    DRAW 0.6s
  END
  TRANSITION fade DURATION 0.4s
END SCENE

SCENE 5 "The response"
  SAY "The response returns quickly, and the cached result helps next time."
    DURATION 4s
    TONE recap
  CREATE response AS RECTANGLE
    POSITION 960 500
    WIDTH 620
    HEIGHT 170
    CORNERS 24
    FILL #DDF3EF
    COLOR #243C46
    TEXT "Response now. Faster reuse later."
    SIZE 36
    DRAW 0.6s
  END
END SCENE
