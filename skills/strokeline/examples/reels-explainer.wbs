// Purpose: Explain one idea in a short vertical-video scene.
// Features used: vertical canvas, narration, styled card, scale animation.
// Validator status: checked with the app pipeline; zero errors and warnings.
// Remaining warnings: none.
VERSION 1.0
CANVAS 1080 1920
STYLE clean
FONT neat
BACKGROUND #101827

SCENE 1 "One useful idea"
  SAY "Make the important idea easy to see."
    DURATION 3s
  WAIT 3s

  CREATE title AS TEXT
    POSITION 540 420
    SIZE 68
    MAXWIDTH 900
    TEXT "One idea. Clearly explained."
    COLOR #FFFFFF
    DRAW 0.5s
  END

  CREATE card AS RECTANGLE
    POSITION 540 980
    WIDTH 720
    HEIGHT 300
    CORNERS 32
    FILL #203B52
    GRADIENT #315A72 #203B52
    SHADOW 18
    TEXT "Show the core, remove the noise"
    COLOR #FFFFFF
    DRAW 0.7s
  END

  ANIMATE card SCALE TO 1.06
    DURATION 0.5s
    EASE easeOut

  SAY "Then leave enough room for the viewer to follow."
    DURATION 3s
  WAIT 3s
END SCENE
