VERSION 1.0
CANVAS 1280 720
STYLE handdrawn

SCENE 1 "Rough fills and smooth arrows"
  CREATE script AS RECTANGLE
    POSITION 230 200
    WIDTH 260
    HEIGHT 150
    TEXT "Script"
    COLOR #16324F
    FILL #8FB4FF
    ROUGH on
    ROUGHNESS 1.5
    ROUGHSEED 7
    ROUGHFILL dots
    PENFOLLOW on
    DRAW 0.8s
  END

  CREATE compile AS ELLIPSE
    POSITION 650 200
    WIDTH 260
    HEIGHT 150
    TEXT "Compile"
    COLOR #8A1C13
    FILL #FF9D8F
    ROUGH on
    ROUGHNESS 1.5
    ROUGHSEED 11
    ROUGHFILL cross-hatch
    DRAW 0.8s
  END

  CREATE animation AS DIAMOND
    POSITION 1050 200
    WIDTH 240
    HEIGHT 160
    TEXT "Animate"
    COLOR #14532D
    FILL #8FDCA9
    ROUGH on
    ROUGHNESS 1.5
    ROUGHSEED 19
    ROUGHFILL hachure
    DRAW 0.8s
  END

  CREATE result AS RECTANGLE
    POSITION 650 520
    WIDTH 300
    HEIGHT 130
    TEXT "Export"
    COLOR #7E22CE
    FILL #E9D5FF
    ROUGH on
    ROUGHSEED 23
    ROUGHFILL zigzag
    DRAW 0.8s
  END

  ARROW script -> compile
    ROUTE elbow
    HEAD end
    PENFOLLOW on
    DRAW 0.6s

  ARROW compile -> animation
    ROUTE curve
    VIA 850 310 900 310
    HEAD end
    DRAW 0.6s

  ARROW animation -> result
    ROUTE elbow
    HEAD end
    DRAW 0.6s
END SCENE
